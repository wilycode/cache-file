{
    "name": "wilycode/cache-file",
    "description": "Lightweight PSR-16 file cache with atomic writes and TTL support.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "WilyCode\\FileCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WilyCode\\FileCache\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Simon Piter"
        }
    ],
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/phpunit.xml",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/.editorconfig",
            "/CONTRIBUTING.md",
            "/CHANGELOG.md",
            "/composer.lock"
        ]
    },
    "homepage": "https://github.com/wilycode/cache-file",
    "support": {
        "issues": "https://github.com/wilycode/cache-file/issues",
        "source": "https://github.com/wilycode/cache-file"
    },
    "keywords": [
        "cache",
        "file-cache",
        "filesystem",
        "psr-16",
        "simple-cache",
        "ttl",
        "php"
    ]
}
